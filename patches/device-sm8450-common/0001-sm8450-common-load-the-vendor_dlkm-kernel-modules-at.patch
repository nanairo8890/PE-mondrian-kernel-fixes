     $(LOCAL_PATH)/rootdir/etc/fstab.qcom:$(TARGET_COPY_OUT_VENDOR_RAMDISK)/first_stage_ramdisk/fstab.qcom
 
+# Second stage kernel modules of vendor_dlkm (rootdir/etc/init.vendor_dlkm.rc):
