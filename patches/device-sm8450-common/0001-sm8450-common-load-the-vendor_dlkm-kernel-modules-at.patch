diff --git a/rootdir/etc/init.vendor_dlkm.rc b/rootdir/etc/init.vendor_dlkm.rc
new file mode 100644
index 0000000..c758d2d
--- /dev/null
+++ b/rootdir/etc/init.vendor_dlkm.rc
@@ -0,0 +1,33 @@
+# SPDX-License-Identifier: Apache-2.0
+#
+# Second stage kernel modules of vendor_dlkm.
+#
+# First stage init loads the vendor_boot ramdisk list. The rest of the
+# kernel release (display, touch, Wi-Fi, audio, video, camera, data) is in
+# /vendor_dlkm/lib/modules with the stock order (modules.load) and the stock
+# blocklist (modules.blocklist), and nothing else loads it.
+#
+# Stock starts a Qualcomm script as vendor.modprobe at early-init. This calls
+# the platform modprobe directly instead: --all loads the list in order with
+# its dependencies through libmodprobe, as first stage init does, -b applies
+# the blocklist, a module that fails does not stop the others, and -s copies
+# the messages to the kernel log. AOSP's vendor_modprobe domain already allows
+# init to run vendor toolbox as vendor_modprobe and to load modules from
+# vendor_file, which is the label of /vendor_dlkm. /vendor_dlkm is mounted in
+# first stage (fstab.qcom), so it is there at early-init.
+
+service vendor.modprobe /vendor/bin/modprobe -b -s --all=/vendor_dlkm/lib/modules/modules.load
+    class main
+    user root
+    group root system
+    disabled
+    oneshot
+    stdio_to_kmsg
+    seclabel u:r:vendor_modprobe:s0
+
+on early-init
+    start vendor.modprobe
+
+# Stock services that need every module wait for this property.
+on property:init.svc.vendor.modprobe=stopped
+    setprop vendor.all.modules.ready 1
diff --git a/tests/test_init_service_review.py b/tests/test_init_service_review.py
index fabfbb5..f59ba64 100644
--- a/tests/test_init_service_review.py
+++ b/tests/test_init_service_review.py
@@ -21,13 +21,34 @@ class InitServiceInventoryTests(unittest.TestCase):
     def test_vital_services_not_deleted_or_falsely_qualified(self):
         status = {x["name"]: x["status"] for x in self.d["key_service_candidates"]}
         for name in ("vendor.qrtr-ns", "vendor.pd_mapper", "vendor.per_mgr",
-                     "vendor.audio-hal", "vendor.sensors-hal-multihal", "vendor.modprobe"):
+                     "vendor.audio-hal", "vendor.sensors-hal-multihal"):
             self.assertIn(name, status)
             self.assertTrue(status[name].startswith("blocked_until_"))
+        # The kernel release ships vendor_dlkm with the stock load list, so
+        # its loader is the one vendor service approved, as an own definition.
+        self.assertEqual(status["vendor.modprobe"], "approved_own_definition")
+
+    def test_vendor_dlkm_loader_is_the_platform_modprobe(self):
+        rc = (ROOT / "rootdir/etc/init.vendor_dlkm.rc").read_text()
+        self.assertIn("service vendor.modprobe /vendor/bin/modprobe -b -s "
+                      "--all=/vendor_dlkm/lib/modules/modules.load", rc)
+        self.assertIn("seclabel u:r:vendor_modprobe:s0", rc)
+        self.assertRegex(rc, r"on early-init\n\s+start vendor\.modprobe")
+        self.assertNotIn("vendor_modprobe.sh", rc)
+        config = (ROOT / "common.mk").read_text()
+        self.assertIn("rootdir/etc/init.vendor_dlkm.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/"
+                      "init.vendor_dlkm.rc", config)
+        fstab = (ROOT / "rootdir/etc/fstab.qcom").read_text()
+        dlkm = [line for line in fstab.splitlines() if line.startswith("vendor_dlkm ")]
+        self.assertTrue(dlkm)
+        self.assertTrue(all("first_stage_mount" in line for line in dlkm))
 
     def test_no_legacy_processes_enabled_before_vendor(self):
         self.assertEqual(self.d["new_tree"]["copied_init_service_definitions"], 0)
-        self.assertEqual(self.d["new_tree"]["active_vendor_services_approved"], 0)
+        approved = [x["name"] for x in self.d["key_service_candidates"]
+                    if x["status"].startswith("approved_")]
+        self.assertEqual(approved, ["vendor.modprobe"])
+        self.assertEqual(self.d["new_tree"]["active_vendor_services_approved"], len(approved))
         config = (ROOT / "common.mk").read_text()
         active = "\n".join(line for line in config.splitlines()
                            if line.strip() and not line.lstrip().startswith("#"))
