index 772f95380387..4681f9b424a5 100644
--- a/drivers/input/touchscreen/goodix_berlin_driver/goodix_ts_core.c
+++ b/drivers/input/touchscreen/goodix_berlin_driver/goodix_ts_core.c
@@ -1264,6 +1264,8 @@ static irqreturn_t goodix_ts_threadirq_func(int irq, void *data)
 	if (likely(!ret)) {
         if (!atomic_read(&core_data->suspended)) { // coor mode
             if (ts_event->event_type & EVENT_TOUCH) {
+                /* The chip flags a finger on the fingerprint sensor. */
+                goodix_xm_fod_press(core_data, !!ts_event->fp_flag);
                 /* report touch */
 #ifdef INPUT_TYPE_B_PROTOCOL
                 goodix_ts_report_finger(core_data, &ts_event->touch_data);
@@ -1831,6 +1833,7 @@ static int goodix_ts_suspend_locked(struct goodix_ts_core *core_data)
 		}
 	}
 
+	goodix_xm_suspend_state(core_data, true);
 	ts_info(dev, "Suspend end");
 	return 0;
 }
@@ -1881,11 +1884,14 @@ static int goodix_ts_resume_locked(struct goodix_ts_core *core_data)
 	 */
 	if (core_data->suspend_gestures)
 		goodix_ts_release_connects(core_data);
+	/* Its FOD-UP may have been lost in the same reset. */
+	goodix_xm_fod_press(core_data, false);
 	core_data->suspend_gestures = 0;
 	/* enable irq */
 	hw_ops->irq_enable(core_data, true);
 	/* open esd */
 	goodix_ts_esd_on(core_data);
+	goodix_xm_suspend_state(core_data, false);
 	ts_info(dev, "Resume end");
 	return 0;
 }
@@ -1910,6 +1916,25 @@ static int goodix_ts_resume(struct goodix_ts_core *core_data)
 	return ret;
 }
 
+/*
+ * A gesture change while the touch is asleep only reaches the chip at the
+ * next suspend. Wake it and suspend it again so it enters the current mask,
+ * from gesture mode, from sleep or from power off alike.
+ */
+void goodix_ts_reapply_gestures(struct goodix_ts_core *core_data)
+{
+	mutex_lock(&core_data->pm_lock);
+	if (core_data->init_stage >= CORE_INIT_STAGE2 &&
+	    atomic_read(&core_data->suspended) &&
+	    core_data->suspend_gestures != READ_ONCE(core_data->gesture_type)) {
+		ts_info(core_data->bus->dev, "apply gestures 0x%x while suspended",
+			READ_ONCE(core_data->gesture_type));
+		goodix_ts_resume_locked(core_data);
+		goodix_ts_suspend_locked(core_data);
+	}
+	mutex_unlock(&core_data->pm_lock);
+}
+
 static void goodix_ts_resume_work(struct work_struct *work)
 {
 	struct goodix_ts_core *cd =
@@ -2146,6 +2171,8 @@ int goodix_ts_stage2_init(struct goodix_ts_core *cd)
 
 	/* gesture init */
 	gesture_module_init(cd);
+	/* Xiaomi touch modes and fingerprint press status */
+	goodix_xm_init(cd);
 
 	/* inspect init */
 	inspect_module_init(cd);
@@ -2457,6 +2484,7 @@ static int goodix_ts_remove(struct platform_device *pdev)
 	goodix_fw_update_uninit(core_data);
 
 	if (core_data->init_stage >= CORE_INIT_STAGE2) {
+		goodix_xm_exit(core_data);
 		gesture_module_exit(core_data);
 		inspect_module_exit(core_data);
 		hw_ops->irq_enable(core_data, false);
diff --git a/drivers/input/touchscreen/goodix_berlin_driver/goodix_ts_core.h b/drivers/input/touchscreen/goodix_berlin_driver/goodix_ts_core.h
index 087c6e4f6549..ff6b9530d901 100644
--- a/drivers/input/touchscreen/goodix_berlin_driver/goodix_ts_core.h
+++ b/drivers/input/touchscreen/goodix_berlin_driver/goodix_ts_core.h
@@ -782,6 +782,10 @@ struct goodix_ts_core {
 	struct pinctrl *pinctrl;
