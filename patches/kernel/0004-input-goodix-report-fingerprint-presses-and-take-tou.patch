 .../goodix_berlin_driver/goodix_ts_core.h     |  22 ++
 .../goodix_berlin_driver/goodix_ts_gesture.c  |   4 +
 .../goodix_berlin_driver/goodix_ts_xiaomi.c   | 192 ++++++++++++++++++
 5 files changed, 247 insertions(+), 1 deletion(-)
 create mode 100644 drivers/input/touchscreen/goodix_berlin_driver/goodix_ts_xiaomi.c

