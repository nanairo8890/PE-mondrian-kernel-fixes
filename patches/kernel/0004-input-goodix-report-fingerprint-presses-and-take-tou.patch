+	struct work_struct xm_apply_work;
 	/* One-shot firmware/setup thread must finish before device teardown. */
 	struct task_struct *init_thread;
 	/* TODO counld we remove this from core data? */
@@ -868,4 +872,22 @@ int goodix_ts_replay_init(struct goodix_ts_core *core_data);
 void goodix_ts_replay_exit(struct goodix_ts_core *core_data);
 int goodix_ts_replay_record(struct goodix_ts_core *core_data, struct goodix_ts_event *ts_event);
 
+/* Re-enter the suspend mode so the chip uses the current gesture mask. */
+void goodix_ts_reapply_gestures(struct goodix_ts_core *cd);
+
+/* Xiaomi touch feature glue (goodix_ts_xiaomi.c). */
+#if IS_REACHABLE(CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE)
+void goodix_xm_init(struct goodix_ts_core *cd);
+void goodix_xm_exit(struct goodix_ts_core *cd);
+void goodix_xm_fod_press(struct goodix_ts_core *cd, bool pressed);
+void goodix_xm_single_tap(struct goodix_ts_core *cd);
+void goodix_xm_suspend_state(struct goodix_ts_core *cd, bool suspended);
+#else
+static inline void goodix_xm_init(struct goodix_ts_core *cd) {}
+static inline void goodix_xm_exit(struct goodix_ts_core *cd) {}
+static inline void goodix_xm_fod_press(struct goodix_ts_core *cd, bool pressed) {}
+static inline void goodix_xm_single_tap(struct goodix_ts_core *cd) {}
+static inline void goodix_xm_suspend_state(struct goodix_ts_core *cd, bool suspended) {}
+#endif
+
 #endif
