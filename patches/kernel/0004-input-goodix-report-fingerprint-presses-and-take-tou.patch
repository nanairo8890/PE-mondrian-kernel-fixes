diff --git a/drivers/input/touchscreen/goodix_berlin_driver/goodix_ts_xiaomi.c b/drivers/input/touchscreen/goodix_berlin_driver/goodix_ts_xiaomi.c
new file mode 100644
index 000000000000..be2a3c6d3e57
--- /dev/null
+++ b/drivers/input/touchscreen/goodix_berlin_driver/goodix_ts_xiaomi.c
@@ -0,0 +1,192 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Xiaomi touch feature glue for the Goodix Berlin touchscreen of mondrian
+ *
+ * The stock fingerprint and touch feature components drive the touch through
+ * /dev/xiaomi-touch modes (Touch_Fod_Enable, Touch_Doubletap_Mode,
+ * Touch_Aod_Enable, Touch_FodIcon_Enable) and wait on
+ * /sys/class/touch/touch_dev/fod_press_status. This file maps those modes to
+ * the driver's gesture mask and reports finger presses on the sensor, as
+ * Xiaomi's own GT9916 driver (marble-s-oss goodix_9916) does
+ */
+#include "goodix_ts_core.h"
+
+#if IS_REACHABLE(CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE)
+#include "../xiaomi/xiaomi_touch.h"
+
+#define GOODIX_XM_GESTURES (GESTURE_DOUBLE_TAP | GESTURE_SINGLE_TAP | GESTURE_FOD_PRESS)
+
+static struct goodix_ts_core *xm_cd;
+static struct xiaomi_touch_interface xm_intf;
+static DEFINE_MUTEX(xm_mode_lock);
+
+static void goodix_xm_set_range(int mode, int min, int max, int def)
+{
+	xm_intf.touch_mode[mode][GET_MIN_VALUE] = min;
+	xm_intf.touch_mode[mode][GET_MAX_VALUE] = max;
+	xm_intf.touch_mode[mode][GET_DEF_VALUE] = def;
+	xm_intf.touch_mode[mode][SET_CUR_VALUE] = def;
+	xm_intf.touch_mode[mode][GET_CUR_VALUE] = def;
+}
+
+/* Caller holds xm_mode_lock. */
+static u32 goodix_xm_gesture_mask(void)
+{
+	u32 mask = 0;
+
+	if (xm_intf.touch_mode[Touch_Doubletap_Mode][GET_CUR_VALUE])
+		mask |= GESTURE_DOUBLE_TAP;
+	if (xm_intf.touch_mode[Touch_Fod_Enable][GET_CUR_VALUE])
+		mask |= GESTURE_FOD_PRESS;
+	if (xm_intf.touch_mode[Touch_Aod_Enable][GET_CUR_VALUE] ||
+	    xm_intf.touch_mode[Touch_FodIcon_Enable][GET_CUR_VALUE])
+		mask |= GESTURE_SINGLE_TAP;
+	return mask;
+}
+
+/* Caller holds xm_mode_lock. */
+static void goodix_xm_apply_locked(struct goodix_ts_core *cd)
+{
+	u32 type = READ_ONCE(cd->gesture_type);
+
+	WRITE_ONCE(cd->gesture_type,
+		   (type & ~GOODIX_XM_GESTURES) | goodix_xm_gesture_mask());
+	/* Applied to the chip at the next suspend, or now if it is asleep. */
+	queue_work(system_freezable_wq, &cd->xm_apply_work);
+}
+
+static void goodix_xm_apply_work(struct work_struct *work)
+{
+	struct goodix_ts_core *cd =
+		container_of(work, struct goodix_ts_core, xm_apply_work);
+
+	goodix_ts_reapply_gestures(cd);
+}
+
+static int goodix_xm_set_mode(int mode, int value)
+{
+	struct goodix_ts_core *cd = READ_ONCE(xm_cd);
+
+	if (!cd || cd->init_stage < CORE_INIT_STAGE2)
+		return -ENODEV;
+	if (mode < 0 || mode >= Touch_Mode_NUM)
+		return -EINVAL;
+
+	mutex_lock(&xm_mode_lock);
+	value = clamp(value, xm_intf.touch_mode[mode][GET_MIN_VALUE],
+		      xm_intf.touch_mode[mode][GET_MAX_VALUE]);
+	xm_intf.touch_mode[mode][SET_CUR_VALUE] = value;
+	xm_intf.touch_mode[mode][GET_CUR_VALUE] = value;
+	ts_info(cd->bus->dev, "xiaomi touch mode %d = %d", mode, value);
+	goodix_xm_apply_locked(cd);
+	mutex_unlock(&xm_mode_lock);
+	return 0;
+}
+
+static int goodix_xm_get_mode(int mode, int value_type)
+{
+	int value;
+
+	if (mode < 0 || mode >= Touch_Mode_NUM ||
+	    value_type < 0 || value_type >= VALUE_TYPE_SIZE)
+		return -EINVAL;
+	mutex_lock(&xm_mode_lock);
+	value = xm_intf.touch_mode[mode][value_type];
+	mutex_unlock(&xm_mode_lock);
+	return value;
+}
+
+static int goodix_xm_get_mode_all(int mode, int *value)
+{
+	if (mode < 0 || mode >= Touch_Mode_NUM || !value)
+		return -EINVAL;
+	mutex_lock(&xm_mode_lock);
+	value[0] = xm_intf.touch_mode[mode][GET_CUR_VALUE];
+	value[1] = xm_intf.touch_mode[mode][GET_DEF_VALUE];
+	value[2] = xm_intf.touch_mode[mode][GET_MIN_VALUE];
+	value[3] = xm_intf.touch_mode[mode][GET_MAX_VALUE];
+	mutex_unlock(&xm_mode_lock);
+	return 0;
+}
+
+/* Mode 0 resets every mode but the panel orientation, as Xiaomi's driver. */
+static int goodix_xm_reset_mode(int mode)
+{
+	struct goodix_ts_core *cd = READ_ONCE(xm_cd);
+	int i;
+
+	if (!cd || cd->init_stage < CORE_INIT_STAGE2)
+		return -ENODEV;
+	if (mode < 0 || mode >= Touch_Mode_NUM)
+		return -EINVAL;
+
+	mutex_lock(&xm_mode_lock);
+	for (i = 0; i < Touch_Mode_NUM; i++) {
+		if ((mode && i != mode) || (!mode && i == Touch_Panel_Orientation))
+			continue;
+		xm_intf.touch_mode[i][SET_CUR_VALUE] = xm_intf.touch_mode[i][GET_DEF_VALUE];
+		xm_intf.touch_mode[i][GET_CUR_VALUE] = xm_intf.touch_mode[i][GET_DEF_VALUE];
+	}
+	goodix_xm_apply_locked(cd);
+	mutex_unlock(&xm_mode_lock);
+	return 0;
+}
+
+void goodix_xm_fod_press(struct goodix_ts_core *cd, bool pressed)
+{
+	if (cd->fod_pressed == pressed)
+		return;
+	if (pressed && !(READ_ONCE(cd->gesture_type) & GESTURE_FOD_PRESS))
+		return;
+	cd->fod_pressed = pressed;
+	ts_info(cd->bus->dev, "fod %s", pressed ? "down" : "up");
+	update_fod_press_status(pressed);
+}
+
+void goodix_xm_single_tap(struct goodix_ts_core *cd)
+{
+	notify_gesture_single_tap();
+}
+
+void goodix_xm_suspend_state(struct goodix_ts_core *cd, bool suspended)
+{
+	xiaomi_touch_set_suspend_state(suspended ? XIAOMI_TOUCH_SUSPEND :
+				       XIAOMI_TOUCH_RESUME);
+}
+
+void goodix_xm_init(struct goodix_ts_core *cd)
+{
+	struct device *dev = cd->bus->dev;
+	int ret;
+
+	INIT_WORK(&cd->xm_apply_work, goodix_xm_apply_work);
+
+	mutex_lock(&xm_mode_lock);
+	memset(&xm_intf, 0, sizeof(xm_intf));
+	goodix_xm_set_range(Touch_Doubletap_Mode, 0, 1, 0);
+	goodix_xm_set_range(Touch_Fod_Enable, 0, 1, 0);
+	goodix_xm_set_range(Touch_Aod_Enable, 0, 1, 0);
+	goodix_xm_set_range(Touch_FodIcon_Enable, 0, 1, 0);
+	goodix_xm_set_range(Touch_Nonui_Mode, 0, 2, 0);
+	xm_intf.setModeValue = goodix_xm_set_mode;
+	xm_intf.getModeValue = goodix_xm_get_mode;
+	xm_intf.getModeAll = goodix_xm_get_mode_all;
+	xm_intf.resetMode = goodix_xm_reset_mode;
+	mutex_unlock(&xm_mode_lock);
+
+	WRITE_ONCE(xm_cd, cd);
+	ret = xiaomitouch_register_modedata(0, &xm_intf);
+	if (ret)
+		ts_err(dev, "xiaomi touch interface not registered: %d", ret);
+	else
+		ts_info(dev, "xiaomi touch interface registered");
+}
+
+void goodix_xm_exit(struct goodix_ts_core *cd)
+{
+	WRITE_ONCE(xm_cd, NULL);
+	cancel_work_sync(&cd->xm_apply_work);
+	if (cd->fod_pressed)
+		goodix_xm_fod_press(cd, false);
+}
+#endif
-- 
