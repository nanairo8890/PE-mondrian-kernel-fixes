--- a/drivers/input/touchscreen/goodix_berlin_driver/Makefile
+++ b/drivers/input/touchscreen/goodix_berlin_driver/Makefile
@@ -3,4 +3,4 @@ obj-$(CONFIG_TOUCHSCREEN_GOODIX_BRL) += goodix_core.o
