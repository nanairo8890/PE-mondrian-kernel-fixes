From 9e295ef3f4cce1c3079ec305c91ca2af5d931dd5 Mon Sep 17 00:00:00 2001
From: Nanairo8890 <301115931+nanairo8890@users.noreply.github.com>
Date: Thu, 26 Nov 2026 01:51:16 -0300
Subject: [PATCH] kernel release: ship stock dual-placed modules in vendor_dlkm
 and dedupe load lists

Run 143 stopped in the release packaging step because the stock load
lists repeat some lines (gh_virt_wdt.ko and qcom_wdt_core.ko in
vendor_ramdisk.modules.load, goodix_core.ko, qca_cld3_qca6490.ko and
others in vendor_dlkm.modules.load) and verify_prebuilt.py rejects a
load list with duplicates

Removing the duplicates alone lets the verifier pass but leaves a
release that does not boot normally: stock keeps 243 modules both in
the vendor_boot ramdisk (for recovery) and in vendor_dlkm (for a normal
boot), and the packager put each module in one place only, so
msm_drm.ko, goodix_core.ko, spi-msm-geni.ko, panel_event_notifier.ko
and the rest of them were left out of vendor_dlkm/modules.load

- read_list() keeps the first occurrence of each name, in stock order
- vendor_dlkm gets every module stock has there, every module that is
  not in the ramdisk, and the dependencies of those that the first
  stage does not load
- a module can now be shipped in both directories

Checked with the stock OS3 module binaries of a mondrian dump (MIUI
V14.0.5.0): verify_prebuilt.py passes, 306 of the 307 stock vendor_dlkm
modules are shipped there, and every second stage dependency is either
in vendor_dlkm or loaded by the first stage
---
 tests/test_package_mondrian_kernel_release.py | 48 +++++++++++++++++++
 tools/package_mondrian_kernel_release.py      | 37 +++++++++-----
 2 files changed, 74 insertions(+), 11 deletions(-)

diff --git a/tests/test_package_mondrian_kernel_release.py b/tests/test_package_mondrian_kernel_release.py
index c7930a5..ab59f54 100644
--- a/tests/test_package_mondrian_kernel_release.py
+++ b/tests/test_package_mondrian_kernel_release.py
@@ -64,6 +64,54 @@ class PackageReleaseTests(unittest.TestCase):
         with mock.patch.object(pkg, "STOCK", self.stock):
             return pkg.package(self.image, [self.mods], self.dt, self.tmp / "out", {"sources": {}})
 
+    def shipped(self, directory):
+        return sorted(p.name for p in (self.tmp / "out" / directory).glob("*.ko"))
+
+    def listed(self, name):
+        return (self.tmp / "out" / name).read_text().splitlines()
+
+    def test_module_stock_keeps_in_both_places_is_shipped_and_loaded_in_both(self):
+        (self.stock / "vendor_ramdisk.modules").write_text("a.ko\nb.ko\ntouch.ko\n")
+        (self.stock / "vendor_ramdisk.modules.load.recovery").write_text("b.ko\na.ko\ntouch.ko\n")
+        (self.stock / "vendor_dlkm.modules").write_text("c.ko\ntouch.ko\n")
+        (self.stock / "vendor_dlkm.modules.load").write_text("touch.ko\nc.ko\n")
+        for name in ("a", "b", "c", "touch"):
+            self.write(name)
+        prov = self.run_package()
+        self.assertEqual(self.shipped("vendor_ramdisk"), ["a.ko", "b.ko", "touch.ko"])
+        self.assertEqual(self.shipped("vendor_dlkm"), ["c.ko", "touch.ko"])
+        self.assertEqual(self.listed("vendor_ramdisk/modules.load"), ["a.ko", "b.ko"])
+        self.assertEqual(self.listed("vendor_ramdisk/modules.load.recovery"), ["b.ko", "a.ko", "touch.ko"])
+        self.assertEqual(self.listed("vendor_dlkm/modules.load"), ["touch.ko", "c.ko"])
+        self.assertEqual((prov["modules"]["vendor_ramdisk"], prov["modules"]["vendor_dlkm"]), (3, 2))
+        self.assertIn("vendor_ramdisk/touch.ko", prov["files"])
+        self.assertIn("vendor_dlkm/touch.ko", prov["files"])
+
+    def test_repeated_stock_list_lines_are_written_once_in_stock_order(self):
+        (self.stock / "vendor_ramdisk.modules.load").write_text("b.ko\na.ko\nb.ko\n")
+        (self.stock / "vendor_ramdisk.modules.load.recovery").write_text("a.ko\na.ko\nb.ko\n")
+        (self.stock / "vendor_dlkm.modules.load").write_text("wlan.ko\nc.ko\nwlan.ko\n")
+        for name in ("a", "b", "c", "wlan"):
+            self.write(name)
+        self.run_package()
+        self.assertEqual(self.listed("vendor_ramdisk/modules.load"), ["b.ko", "a.ko"])
+        self.assertEqual(self.listed("vendor_ramdisk/modules.load.recovery"), ["a.ko", "b.ko"])
+        self.assertEqual(self.listed("vendor_dlkm/modules.load"), ["wlan.ko", "c.ko"])
+
+    def test_dependency_the_first_stage_does_not_load_is_also_in_vendor_dlkm(self):
+        (self.stock / "vendor_ramdisk.modules").write_text("a.ko\nb.ko\nrecovery_only.ko\n")
+        (self.stock / "vendor_ramdisk.modules.load.recovery").write_text("recovery_only.ko\n")
+        self.write("a")
+        self.write("b")
+        self.write("base")
+        self.write("recovery_only", depends="base")
+        self.write("c", depends="recovery_only,b")
+        self.write("wlan")
+        self.run_package()
+        self.assertEqual(self.shipped("vendor_ramdisk"), ["a.ko", "b.ko", "base.ko", "recovery_only.ko"])
+        self.assertEqual(self.shipped("vendor_dlkm"), ["base.ko", "c.ko", "recovery_only.ko", "wlan.ko"])
+        self.assertEqual(self.listed("vendor_dlkm/modules.load"), ["c.ko", "wlan.ko"])
+
     def test_stock_placement_order_and_dependency_closure(self):
         self.write("a", depends="helper")
         self.write("b")
diff --git a/tools/package_mondrian_kernel_release.py b/tools/package_mondrian_kernel_release.py
index 6613524..590b9db 100644
--- a/tools/package_mondrian_kernel_release.py
+++ b/tools/package_mondrian_kernel_release.py
@@ -11,9 +11,13 @@ vendor_dlkm and their load lists):
 * vendor_ramdisk/: the modules stock has in its vendor_boot ramdisk, plus
   every module they depend on; modules.load and modules.load.recovery are
   the stock lists, in stock order, limited to the modules we ship;
-* vendor_dlkm/: every other module; modules.load is the stock list of
-  vendor_dlkm (which also names the modules Xiaomi keeps in /vendor, such
-  as the WLAN driver), limited to the modules we ship.
+* vendor_dlkm/: the modules stock has in its vendor_dlkm (many of them are
+  in the ramdisk too), every module that is not in the ramdisk, and the
+  dependencies of those that the first stage does not load; modules.load is
+  the stock list of vendor_dlkm (which also names the modules Xiaomi keeps
+  in /vendor, such as the WLAN driver), limited to the modules we ship.
+
+Repeated lines of the stock lists are written once.
 
 Every module must carry the vermagic of the Image's kernel release and
 every dependency must be shipped. The stock modules we do not build are
@@ -80,8 +84,11 @@ def kernel_release(image):
 
 
 def read_list(name):
-    return [line.strip() for line in (STOCK / name).read_text().splitlines()
-            if line.strip() and not line.startswith("#")]
+    """Module names of a stock list, in order. Stock repeats some lines and
+    mondrian-kernel rejects a load list with duplicates."""
+    return list(dict.fromkeys(
+        line.strip() for line in (STOCK / name).read_text().splitlines()
+        if line.strip() and not line.startswith("#")))
 
 
 def collect(paths):
@@ -131,7 +138,14 @@ def package(image, module_roots, dt_dir, out, provenance, strip=None):
 
     stock_ramdisk = set(read_list("vendor_ramdisk.modules"))
     ramdisk = closure([n for n in modules if n in stock_ramdisk], deps)
-    dlkm = set(modules) - ramdisk
+    # Stock ships many modules twice: in the ramdisk for recovery and in
+    # vendor_dlkm, whose list loads them in a normal boot.
+    stock_dlkm = set(read_list("vendor_dlkm.modules"))
+    dlkm = {n for n in modules if n in stock_dlkm or n not in ramdisk}
+    # Dependencies that only the ramdisk holds must have been loaded by the
+    # first stage; vendor_dlkm needs its own copy of any other one.
+    first_stage = closure([n for n in read_list("vendor_ramdisk.modules.load") if n in ramdisk], deps)
+    dlkm |= closure(dlkm, deps) - first_stage
 
     if out.exists():
         shutil.rmtree(out)
@@ -139,11 +153,12 @@ def package(image, module_roots, dt_dir, out, provenance, strip=None):
     (out / "vendor_dlkm").mkdir()
     (out / "dtbs").mkdir()
     shutil.copyfile(image, out / "Image")
-    for name in modules:
-        dest = out / ("vendor_ramdisk" if name in ramdisk else "vendor_dlkm") / name
-        shutil.copyfile(modules[name], dest)
-        if strip:
-            subprocess.run([strip, "--strip-debug", str(dest)], check=True)
+    for directory, names in (("vendor_ramdisk", ramdisk), ("vendor_dlkm", dlkm)):
+        for name in sorted(names):
+            dest = out / directory / name
+            shutil.copyfile(modules[name], dest)
+            if strip:
+                subprocess.run([strip, "--strip-debug", str(dest)], check=True)
     loads = {
         "vendor_ramdisk/modules.load": [n for n in read_list("vendor_ramdisk.modules.load") if n in ramdisk],
         "vendor_ramdisk/modules.load.recovery":
-- 
